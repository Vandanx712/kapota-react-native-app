{
  "expo": {
    "name": "Kapota",
    "slug": "Kapota",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kapotamobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.kapotachatapp",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.kapotachatapp",
      "supportsTablet": true
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/kapota-splash-logo.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Kapota to access your location to discover nearby places and connect with your community."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/kapota-splash-logo.png",
          "color": "#5B4CF0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
