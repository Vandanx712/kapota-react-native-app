{
  "expo": {
    "name": "Kapota",
    "slug": "Kapota",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kapotamobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/kapota-splash-logo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-image",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
